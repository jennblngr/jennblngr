# Copier en .env (jamais commité) pour scripts/sync-activity.mjs et
# scripts/sync-experience-stats.mjs

# Obligatoire — compte GitHub personnel (scripts/sync-activity.mjs uniquement)
GITHUB_USERNAME=jennblngr
GITHUB_TOKEN=ghp_xxx   # PAT classique, aucun scope particulier requis pour la lecture du profil public

# GitLab d'entreprise — optionnel pour sync-activity.mjs (absent/vide = le script continue
# avec GitHub seul, utile le jour où l'accès à ce GitLab expirera : l'historique déjà
# collecté reste intact), obligatoire pour sync-experience-stats.mjs.
GITLAB_URL=https://gitlab.mon-entreprise.example
GITLAB_USERNAME=xxx   # peut différer de GITHUB_USERNAME
GITLAB_TOKEN=glpat-xxx   # PAT avec le scope "read_api"

# Formulaire de contact (EmailJS, https://www.emailjs.com) — ces variables sont préfixées
# VITE_ donc elles finissent dans le bundle client en clair, mais ce sont des identifiants
# publics par design chez EmailJS (pas de secret serveur ici), pas l'adresse email elle-même.
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=xxx
